{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sketchup-mcp/operations.schema.json",
  "title": "SketchUp MCP operation primitives",
  "$defs": {
    "length": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "mm",
            "cm",
            "m",
            "in",
            "ft"
          ]
        }
      }
    },
    "coordinate": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "entityReference": {
      "type": "string",
      "pattern": "^entity_[A-Za-z0-9_-]{8,128}$"
    },
    "statusArguments": {
      "type": "object",
      "additionalProperties": false
    },
    "entityQueryArguments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "entity_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "maxItems": 32,
          "uniqueItems": true
        }
      }
    }
  }
}
